  create temporary table "dim_user__dbt_tmp033755455158"
  
  
    as
  
  (
    

SELECT
	id,
	first_name,
	last_name,
	CASE
		WHEN gender IN ('Agender', 'Genderfluid', 'Non-binary', 'Bigender', 'Polygender', 'Genderqueer')
			THEN 'Other'
		ELSE
			gender
	END AS gender,
	registration_date,
